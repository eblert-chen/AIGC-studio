{
  "name": "ai-video",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "vendor/storyai-3d-director-desk"
  ],
  "scripts": {
    "director:build": "npm run build --workspace storyai-3d-director-desk",
    "predev": "npm run director:build",
    "dev": "vite",
    "services:start:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-all-local.ps1",
    "models:status:local": "node scripts/local-video-lab.mjs status",
    "models:verify:local": "node scripts/local-video-lab.mjs verify",
    "models:prepare:live": "node scripts/local-video-lab.mjs prepare-live",
    "models:onboard:plan": "node scripts/provider-model-onboarding.mjs plan",
    "models:onboard:check": "node scripts/provider-model-onboarding.mjs check",
    "models:onboard:apply": "node scripts/provider-model-onboarding.mjs apply",
    "build": "npm run director:build && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node scripts/run-root-tests.mjs",
    "test:browser": "playwright test",
    "test:google-video-browser": "playwright test --config tests/browser/google-video.playwright.config.mjs",
    "auth0:login": "node scripts/auth0-universal-login.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:relay-migration": "node --test tests/relay-migration-acceptance.test.mjs tests/relay-live-fault-evidence.test.mjs tests/relay-fault-source-snapshot.test.mjs tests/relay-live-staging-workflow.test.mjs tests/relay-obs-live-runner.test.mjs",
    "test:relay-faults": "node scripts/run-relay-fault-harness.mjs",
    "test:relay-live-faults": "node scripts/run-relay-live-fault-harness.mjs",
    "test:relay-cost-contract": "node --test tests/cross-service-cost-acceptance.test.mjs",
    "test:relay-deployment": "node --test tests/relay-production-deployment.test.mjs",
    "test:relay-download-edge-image": "node scripts/smoke-relay-download-edge-image.mjs",
    "test:relay-secret-paths": "node scripts/check-relay-secret-paths.mjs",
    "relay:candidate:write": "node scripts/relay-candidate-baseline.mjs --write",
    "relay:candidate:check": "node scripts/relay-candidate-baseline.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "@xyflow/react": "^12.11.6",
    "postcss": "8.5.26",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.10.1",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
