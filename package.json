{
  "name": "ai-video",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:relay-migration": "node --test tests/relay-migration-acceptance.test.mjs tests/relay-live-fault-evidence.test.mjs tests/relay-fault-source-snapshot.test.mjs tests/relay-obs-live-runner.test.mjs",
    "test:relay-faults": "node scripts/run-relay-fault-harness.mjs",
    "test:relay-live-faults": "node scripts/run-relay-live-fault-harness.mjs",
    "test:relay-cost-contract": "node --test tests/cross-service-cost-acceptance.test.mjs",
    "test:relay-deployment": "node --test tests/relay-production-deployment.test.mjs",
    "test:relay-download-edge-image": "node scripts/smoke-relay-download-edge-image.mjs",
    "test:relay-secret-paths": "node scripts/check-relay-secret-paths.mjs",
    "relay:candidate:write": "node scripts/relay-candidate-baseline.mjs --write",
    "relay:candidate:check": "node scripts/relay-candidate-baseline.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "postcss": "8.5.25",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.10.1",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "pptxgenjs": "^4.0.1"
  }
}
