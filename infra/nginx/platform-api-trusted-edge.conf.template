# Rendered by the official Nginx entrypoint only in the protected Compose
# overlay. The host TLS ingress must discard caller-supplied forwarding headers
# and set the header to the actual peer address only. Nginx then resolves that trusted
# hop and forwards a single canonical X-Forwarded-For value to Platform.
set_real_ip_from ${PLATFORM_TRUSTED_EDGE_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;
