{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-video.example/schemas/platform-process-runtime-secrets.schema.json",
  "title": "Platform process runtime secrets",
  "description": "Closed, role-specific Platform runtime credential bundles. Values are rendered only by the approved secret manager.",
  "oneOf": [
    { "$ref": "#/$defs/migrationDocument" },
    { "$ref": "#/$defs/apiDocument" },
    { "$ref": "#/$defs/dispatcherDocument" },
    { "$ref": "#/$defs/relaySyncDocument" },
    { "$ref": "#/$defs/timeoutDocument" },
    { "$ref": "#/$defs/publishingDocument" },
    { "$ref": "#/$defs/downloadGatewayDocument" }
  ],
  "$defs": {
    "secret": {
      "type": "string",
      "minLength": 32,
      "maxLength": 16384,
      "pattern": "^\\S{32,}$"
    },
    "nullableSecret": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/secret" }
      ]
    },
    "databaseUrl": {
      "type": "string",
      "minLength": 40,
      "maxLength": 8192,
      "pattern": "^postgresql\\+psycopg://[^/?#]+/[^/?#]+\\?sslmode=verify-full&sslrootcert=%2F[^?#\\r\\n]+$"
    },
    "relayBackends": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["base_url", "client_id", "api_key", "contract_revision"],
        "properties": {
          "base_url": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://[^?#]+$" },
          "client_id": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" },
          "api_key": { "$ref": "#/$defs/secret" },
          "contract_revision": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,79}$" }
        }
      }
    },
    "callbackSecrets": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "additionalProperties": { "$ref": "#/$defs/secret" }
    },
    "credentialMap": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]{0,79}$" },
      "additionalProperties": { "$ref": "#/$defs/secret" }
    },
    "pluginMap": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "maxLength": 256,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": { "$ref": "#/$defs/credentialMap" }
    },
    "apiPluginCredentials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapters"],
      "properties": { "adapters": { "$ref": "#/$defs/pluginMap" } }
    },
    "workerPluginCredentials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapters", "media_resolvers"],
      "properties": {
        "adapters": { "$ref": "#/$defs/pluginMap" },
        "media_resolvers": { "$ref": "#/$defs/pluginMap" }
      }
    },
    "relaySecrets": {
      "type": "object",
      "required": ["database_url", "relay_backends"],
      "properties": {
        "database_url": { "$ref": "#/$defs/databaseUrl" },
        "relay_backends": { "$ref": "#/$defs/relayBackends" }
      }
    },
    "relayOnlySecrets": {
      "allOf": [{ "$ref": "#/$defs/relaySecrets" }],
      "unevaluatedProperties": false
    },
    "migrationSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database_url"],
      "properties": { "database_url": { "$ref": "#/$defs/databaseUrl" } }
    },
    "dispatcherSecrets": {
      "allOf": [
        { "$ref": "#/$defs/relaySecrets" },
        {
          "type": "object",
          "required": ["huawei_obs_access_key_id", "huawei_obs_secret_access_key", "huawei_obs_security_token"],
          "properties": {
            "huawei_obs_access_key_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S+$" },
            "huawei_obs_secret_access_key": { "$ref": "#/$defs/secret" },
            "huawei_obs_security_token": { "$ref": "#/$defs/nullableSecret" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "apiSecrets": {
      "allOf": [
        { "$ref": "#/$defs/relaySecrets" },
        {
          "type": "object",
          "required": [
            "relay_tenant_id", "relay_operations_token", "relay_reconciliation_approval_key_id", "relay_reconciliation_approval_secret",
            "relay_callback_signing_secrets", "internal_service_token", "download_edge_completion_service_token",
            "channel_cost_signing_secret", "relay_telemetry_signing_secret", "provider_alert_signing_secret", "provider_alert_forward_signing_secret",
            "download_completion_edge_gateway_signing_secret", "download_completion_obs_access_log_signing_secret", "download_gateway_service_token",
            "download_gateway_registration_signing_secret", "download_gateway_attempt_encryption_key_base64", "jwt_signing_secret",
            "huawei_obs_access_key_id", "huawei_obs_secret_access_key", "huawei_obs_security_token", "publishing_plugin_credentials"
          ],
          "properties": {
            "relay_tenant_id": { "type": "string", "format": "uuid" },
            "relay_operations_token": { "$ref": "#/$defs/secret" },
            "relay_reconciliation_approval_key_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$" },
            "relay_reconciliation_approval_secret": { "$ref": "#/$defs/secret" },
            "relay_callback_signing_secrets": { "$ref": "#/$defs/callbackSecrets" },
            "internal_service_token": { "$ref": "#/$defs/secret" },
            "download_edge_completion_service_token": { "$ref": "#/$defs/secret" },
            "channel_cost_signing_secret": { "$ref": "#/$defs/secret" },
            "relay_telemetry_signing_secret": { "$ref": "#/$defs/secret" },
            "provider_alert_signing_secret": { "$ref": "#/$defs/secret" },
            "provider_alert_forward_signing_secret": { "$ref": "#/$defs/secret" },
            "download_completion_edge_gateway_signing_secret": { "$ref": "#/$defs/secret" },
            "download_completion_obs_access_log_signing_secret": { "$ref": "#/$defs/secret" },
            "download_gateway_service_token": { "$ref": "#/$defs/secret" },
            "download_gateway_registration_signing_secret": { "$ref": "#/$defs/secret" },
            "download_gateway_attempt_encryption_key_base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$" },
            "jwt_signing_secret": { "$ref": "#/$defs/secret" },
            "huawei_obs_access_key_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S+$" },
            "huawei_obs_secret_access_key": { "$ref": "#/$defs/secret" },
            "huawei_obs_security_token": { "$ref": "#/$defs/nullableSecret" },
            "publishing_plugin_credentials": { "$ref": "#/$defs/apiPluginCredentials" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "publishingSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database_url", "publishing_plugin_credentials"],
      "properties": {
        "database_url": { "$ref": "#/$defs/databaseUrl" },
        "publishing_plugin_credentials": { "$ref": "#/$defs/workerPluginCredentials" }
      }
    },
    "downloadGatewaySecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database_url", "download_gateway_service_token", "download_gateway_registration_signing_secret", "download_gateway_attempt_encryption_key_base64"],
      "properties": {
        "database_url": { "$ref": "#/$defs/databaseUrl" },
        "download_gateway_service_token": { "$ref": "#/$defs/secret" },
        "download_gateway_registration_signing_secret": { "$ref": "#/$defs/secret" },
        "download_gateway_attempt_encryption_key_base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$" }
      }
    },
    "migrationDocument": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "process_role", "secrets"],
      "properties": {
        "kind": { "const": "platform_process_runtime_secrets" }, "schema_version": { "const": 1 },
        "process_role": { "const": "migration" },
        "secrets": {
          "allOf": [
            { "$ref": "#/$defs/migrationSecrets" },
            { "properties": { "database_url": { "pattern": "^postgresql\\+psycopg://platform_migration:" } } }
          ]
        }
      }
    },
    "apiDocument": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "process_role", "secrets"],
      "properties": {
        "kind": { "const": "platform_process_runtime_secrets" }, "schema_version": { "const": 1 },
        "process_role": { "const": "platform-api" },
        "secrets": {
          "allOf": [
            { "$ref": "#/$defs/apiSecrets" },
            { "properties": { "database_url": { "pattern": "^postgresql\\+psycopg://platform_api:" } } }
          ]
        }
      }
    },
    "dispatcherDocument": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "process_role", "secrets"],
      "properties": {
        "kind": { "const": "platform_process_runtime_secrets" }, "schema_version": { "const": 1 },
        "process_role": { "const": "dispatcher" },
        "secrets": {
          "allOf": [
            { "$ref": "#/$defs/dispatcherSecrets" },
            { "properties": { "database_url": { "pattern": "^postgresql\\+psycopg://platform_dispatcher:" } } }
          ]
        }
      }
    },
    "relaySyncDocument": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "process_role", "secrets"],
      "properties": {
        "kind": { "const": "platform_process_runtime_secrets" }, "schema_version": { "const": 1 },
        "process_role": { "const": "relay-sync" },
        "secrets": {
          "allOf": [
            { "$ref": "#/$defs/relayOnlySecrets" },
            { "properties": { "database_url": { "pattern": "^postgresql\\+psycopg://platform_relay_sync:" } } }
          ]
        }
      }
    },
    "timeoutDocument": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "process_role", "secrets"],
      "properties": {
        "kind": { "const": "platform_process_runtime_secrets" }, "schema_version": { "const": 1 },
        "process_role": { "const": "timeout-worker" },
        "secrets": {
          "allOf": [
            { "$ref": "#/$defs/relayOnlySecrets" },
            { "properties": { "database_url": { "pattern": "^postgresql\\+psycopg://platform_timeout_worker:" } } }
          ]
        }
      }
    },
    "publishingDocument": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "process_role", "secrets"],
      "properties": {
        "kind": { "const": "platform_process_runtime_secrets" }, "schema_version": { "const": 1 },
        "process_role": { "const": "publishing-worker" },
        "secrets": {
          "allOf": [
            { "$ref": "#/$defs/publishingSecrets" },
            { "properties": { "database_url": { "pattern": "^postgresql\\+psycopg://platform_publishing_worker:" } } }
          ]
        }
      }
    },
    "downloadGatewayDocument": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "process_role", "secrets"],
      "properties": {
        "kind": { "const": "platform_process_runtime_secrets" }, "schema_version": { "const": 1 },
        "process_role": { "const": "download-gateway-registration-worker" },
        "secrets": {
          "allOf": [
            { "$ref": "#/$defs/downloadGatewaySecrets" },
            { "properties": { "database_url": { "pattern": "^postgresql\\+psycopg://platform_download_gateway_worker:" } } }
          ]
        }
      }
    }
  }
}
