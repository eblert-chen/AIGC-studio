{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-video.invalid/relay-api-runtime-secrets.schema.json",
  "title": "Protected Relay API runtime secret bundle",
  "description": "Secret-bearing schema for the long-lived protected new-api Relay API. This schema deliberately contains no example secret values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "redis_dsn",
    "application",
    "clients",
    "operations_credentials",
    "reconciliation_approval_keys",
    "internal_admission_token",
    "artifact_signing_secret",
    "huawei_obs",
    "provider_alert_signing_secret",
    "platform_internal_service_token",
    "channel_cost_signing_secret",
    "telemetry_signing_secret"
  ],
  "properties": {
    "kind": { "const": "relay_api_runtime_secrets" },
    "schema_version": { "const": 1 },
    "redis_dsn": {
      "type": "string",
      "pattern": "^rediss://[^#?]+$",
      "$comment": "Must parse as a rediss URL with a non-empty password and no query, fragment, control byte or surrounding whitespace."
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_secret", "crypto_secret"],
      "properties": {
        "session_secret": { "$ref": "#/$defs/secret32" },
        "crypto_secret": { "$ref": "#/$defs/secret32" }
      }
    },
    "clients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "$comment": "Items must be in strictly increasing client_id order and must exactly match the A-bundle client_id/tenant_id sequence. Multiple clients may share a tenant, but client_id is unique.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["client_id", "tenant_id", "api_key"],
        "properties": {
          "client_id": { "$ref": "#/$defs/client_id" },
          "tenant_id": { "$ref": "#/$defs/canonical_uuid" },
          "api_key": { "$ref": "#/$defs/secret32" },
          "callback_url": { "type": "string", "minLength": 1 },
          "callback_signing_secret": { "$ref": "#/$defs/secret32" }
        },
        "allOf": [
          {
            "if": { "required": ["callback_url"] },
            "then": { "required": ["callback_signing_secret"] },
            "else": { "not": { "required": ["callback_signing_secret"] } }
          }
        ]
      }
    },
    "operations_credentials": {
      "type": "array",
      "minItems": 1,
      "$comment": "Items must be sorted by tenant_id then token_sha256. Every client tenant must have at least one operations credential; duplicate tenant/digest identities are rejected.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tenant_id", "token_sha256"],
        "properties": {
          "tenant_id": { "$ref": "#/$defs/canonical_uuid" },
          "token_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "$comment": "SHA-256 of the independently generated operations bearer token; the raw token is owned by the caller and is not stored in this bundle."
          }
        }
      }
    },
    "reconciliation_approval_keys": {
      "type": "array",
      "minItems": 1,
      "$comment": "Items must be sorted by tenant_id then key_id. Every client tenant must have at least one approval key; duplicate tenant/key_id identities are rejected.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tenant_id", "key_id", "secret"],
        "properties": {
          "tenant_id": { "$ref": "#/$defs/canonical_uuid" },
          "key_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$"
          },
          "secret": { "$ref": "#/$defs/secret32" }
        }
      }
    },
    "internal_admission_token": { "$ref": "#/$defs/secret32" },
    "artifact_signing_secret": { "$ref": "#/$defs/secret32" },
    "huawei_obs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access_key_id", "secret_access_key"],
      "properties": {
        "access_key_id": { "$ref": "#/$defs/secret16" },
        "secret_access_key": { "$ref": "#/$defs/secret32" },
        "security_token": { "$ref": "#/$defs/secret16" }
      }
    },
    "provider_alert_signing_secret": { "$ref": "#/$defs/secret32" },
    "platform_internal_service_token": { "$ref": "#/$defs/secret32" },
    "channel_cost_signing_secret": { "$ref": "#/$defs/secret32" },
    "telemetry_signing_secret": { "$ref": "#/$defs/secret32" }
  },
  "$comment": "All secret values, the decoded Redis password, all operations-token digests, and both sk-/bare presentations from the A bundle must be globally pairwise independent. The Go parser/installer enforces control-byte, placeholder, diversity, identity-coverage and immutable-install rules that JSON Schema cannot express.",
  "$defs": {
    "canonical_uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    },
    "client_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "secret16": {
      "type": "string",
      "minLength": 16,
      "$comment": "The runtime parser additionally rejects surrounding whitespace, C0/DEL controls, placeholders, low diversity and digest reuse."
    },
    "secret32": {
      "type": "string",
      "minLength": 32,
      "$comment": "The runtime parser additionally rejects surrounding whitespace, C0/DEL controls, placeholders, low diversity and digest reuse."
    }
  }
}
