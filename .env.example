# Local persistent integration stack (`docker compose up`).
# Replace every value before using a shared environment.
POSTGRES_PASSWORD=replace-with-a-long-local-password
# Development-only Platform authentication and initialization. Production must
# set both switches to false and leave PLATFORM_BOOTSTRAP_TOKEN unset.
PLATFORM_DEVELOPMENT_HEADER_AUTH_ENABLED=true
PLATFORM_ENABLE_BOOTSTRAP=true
PLATFORM_BOOTSTRAP_TOKEN=local-platform-bootstrap-secret-2026-08-14
# The extended new-api service is the only Compose Relay data plane.
PLATFORM_RELAY_BASE_URL=http://relay-new-api:3000
RELAY_CLIENT_ID=customer-platform
RELAY_API_KEY=replace-with-a-long-random-customer-platform-relay-key
RELAY_TENANT_ID=00000000-0000-4000-8000-000000000001
# Platform generation and operations traffic share the same canonical new-api
# origin while retaining separate bearer and approval-signing credentials.
PLATFORM_RELAY_OPERATIONS_BASE_URL=http://relay-new-api:3000
# Optional owner-only local break-glass entry. Use only loopback HTTP during
# development; production requires a dedicated protected HTTPS origin.
PLATFORM_RELAY_NATIVE_ADMIN_CONSOLE_ORIGIN=
PLATFORM_RELAY_OPERATIONS_TENANT_ID=00000000-0000-4000-8000-000000000001
PLATFORM_RELAY_OPERATIONS_TOKEN=local-platform-relay-operations-token-change-me-03
PLATFORM_RELAY_RECONCILIATION_APPROVAL_KEY_ID=local-platform-approval-v1
PLATFORM_RELAY_RECONCILIATION_APPROVAL_SECRET=local-platform-reconciliation-approval-secret-change-me-04
INTERNAL_TIKTOK_RELAY_API_KEY=replace-with-a-different-long-random-tiktok-relay-key
INTERNAL_TIKTOK_RELAY_TENANT_ID=00000000-0000-4000-8000-000000000002
INTERNAL_TIKTOK_RELAY_OPERATIONS_API_KEY=replace-with-a-different-tiktok-operations-only-key
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-internal-token
CHANNEL_COST_SIGNING_SECRET=replace-with-a-different-long-random-channel-cost-signing-secret
CHANNEL_COST_SIGNATURE_REQUIRED=true
CHANNEL_COST_SIGNATURE_MAX_AGE_SECONDS=300
# Dedicated new-api -> Platform task-stage and operations telemetry signature.
# Keep this independent from the service token, alert secret, and cost secret.
RELAY_TELEMETRY_SIGNING_SECRET=replace-with-an-independent-long-random-relay-telemetry-signing-secret
RELAY_TELEMETRY_SIGNATURE_MAX_AGE_SECONDS=300
# Signed provider-alert bridge. new-api signs the exact bytes with the inbound
# secret; Platform persists an immutable idempotency receipt only after this
# downstream URL accepts the event. Keep both secrets independent and inject
# them from the server secret manager, never from frontend configuration.
PROVIDER_ALERT_SIGNATURE_MAX_AGE_SECONDS=300
PROVIDER_ALERT_FORWARD_WEBHOOK_URL=
PROVIDER_ALERT_FORWARD_SIGNING_SECRET=
PROVIDER_ALERT_FORWARD_TIMEOUT_SECONDS=5
DOWNLOAD_COMPLETION_EDGE_GATEWAY_SIGNING_SECRET=replace-with-a-different-long-random-edge-download-signing-secret
DOWNLOAD_COMPLETION_OBS_ACCESS_LOG_SIGNING_SECRET=replace-with-a-different-long-random-obs-download-signing-secret
DOWNLOAD_COMPLETION_SIGNATURE_MAX_AGE_SECONDS=300
# Platform -> controlled local download edge. Protected staging/production use
# their separate HTTPS inventories and never permit a direct OBS URL fallback.
DOWNLOAD_GATEWAY_REGISTRATION_URL=http://relay-download-edge:8080/internal/v1/download-tickets
DOWNLOAD_GATEWAY_PUBLIC_BASE_URL=http://127.0.0.1:8400
DOWNLOAD_GATEWAY_SERVICE_TOKEN=replace-with-an-independent-random-gateway-service-token
DOWNLOAD_GATEWAY_REGISTRATION_SIGNING_SECRET=replace-with-an-independent-random-registration-signing-secret
DOWNLOAD_GATEWAY_TIMEOUT_SECONDS=10
RELAY_ALLOW_LEGACY_ARTIFACT_DOWNLOAD_RESPONSE=false
INPUT_ASSET_SIGNING_SECRET=replace-with-a-long-random-input-asset-signing-key
RELAY_CALLBACK_SIGNING_SECRET=replace-with-a-long-random-callback-signing-key
RELAY_DISPATCH_MAX_ATTEMPTS=12
NEW_API_RELAY_PROVIDER_FAILURE_THRESHOLD=3
NEW_API_RELAY_PROVIDER_COOLDOWN_SECONDS=30
TASK_QUEUED_TIMEOUT_SECONDS=3600
TASK_PROCESSING_TIMEOUT_SECONDS=21600
TASK_TIMEOUT_SCAN_INTERVAL_SECONDS=30
TASK_TIMEOUT_BATCH_SIZE=100
# The publishing mock is an explicit local/test adapter and production rejects it.
PUBLISHING_MOCK_ENABLED=false
PUBLISHING_WORKER_ENABLED=true
# Comma-separated trusted `python.module:factory` adapter factories. Production
# worker startup rejects an empty registry, Mock, and adapters that do not
# declare `production_ready=true`.
PUBLISHING_ADAPTERS=
# Public Platform callback and customer-app return URL used only by adapters
# that implement the server-side PublisherOAuthAdapter contract.
PUBLISHING_OAUTH_CALLBACK_URL=http://127.0.0.1:8200/api/v1/publishing/oauth/callback
PUBLISHING_OAUTH_SUCCESS_URL=http://127.0.0.1:4173/publishing
PUBLISHING_OAUTH_STATE_TTL_SECONDS=600
# One trusted `python.module:factory` resolver that returns provider-readable
# URLs for durable platform artifacts. Production startup rejects an empty value.
PUBLISHING_MEDIA_RESOLVER=
PUBLISHING_WORKER_POLL_INTERVAL_SECONDS=1
PUBLISHING_WORKER_BATCH_SIZE=50
PUBLISHING_LEASE_SECONDS=60
PUBLISHING_MAX_ATTEMPTS=5
PLATFORM_HOST_PORT=8200
GATEWAY_HOST_PORT=8180

# Default extended new-api Relay and controlled-download edge.
NEW_API_RELAY_HOST_PORT=8300
NEW_API_RELAY_IMAGE_TAG=0ab0202-local
NEW_API_RELAY_NODE_TYPE=master
NEW_API_RELAY_NODE_NAME=relay-new-api-local-1
# Keep local database/Redis passwords to the unreserved URL alphabet
# (A-Z, a-z, 0-9, `_`, `-`) because they are embedded in connection URLs.
# Production credentials must come from a secret manager.
NEW_API_POSTGRES_PASSWORD=replace-with-a-long-url-safe-new-api-postgres-password
NEW_API_REDIS_PASSWORD=replace-with-a-long-url-safe-new-api-redis-password
NEW_API_SESSION_SECRET=replace-with-a-long-random-new-api-session-secret
NEW_API_CRYPTO_SECRET=replace-with-a-different-random-new-api-crypto-secret
NEW_API_RELAY_COMPAT_ENVIRONMENT=development
# Staging/production must inject the committed extension-fork revision and the
# exact deployed image manifest digest. The pinned upstream revision alone is
# not provenance for this repository's Relay extensions.
NEW_API_RELAY_SOURCE_REVISION=
NEW_API_RELAY_IMAGE_DIGEST=
NEW_API_RELAY_SOURCE_SNAPSHOT_SHA256=
NEW_API_RELAY_SOURCE_SNAPSHOT_FILE_COUNT=
# Secret-free Ed25519 verification keys, for example {"release-2026-q3":"<base64-public-key>"}.
# Canonicalize this JSON and embed its SHA-256 in the image with Docker build
# arg RELAY_BUILD_ROUTE_ACCEPTANCE_KEYS_SHA256. Never inject a private key into
# the Relay image, environment, filesystem, or secret store.
NEW_API_RELAY_ROUTE_ACCEPTANCE_PUBLIC_KEYS_JSON={}
NEW_API_RELAY_ROUTE_ACCEPTANCE_KEYS_SHA256=
# Full native new-api tokens for two isolated service identities. These are not
# the Platform-facing RELAY_API_KEY values and must never be reused as such.
NEW_API_CUSTOMER_PLATFORM_UPSTREAM_TOKEN=replace-with-new-api-customer-platform-token
NEW_API_INTERNAL_TIKTOK_UPSTREAM_TOKEN=replace-with-new-api-internal-tiktok-token
# Array of tenant-bound SHA-256 token digests for internal operations. Every
# tenant may reconcile only its own tasks. Secure Compose separately pins
# global channel control to RELAY_TENANT_ID, so the TikTok operations tenant
# cannot test, enable, or disable shared upstream channels. This local example
# enables one Platform control tenant; protected deployments replace the whole
# credential set with independently generated secrets.
NEW_API_RELAY_OPERATIONS_CREDENTIALS_JSON=[{"tenant_id":"00000000-0000-4000-8000-000000000001","token_sha256":"56e12910b642ccd23bb552175d2e9f465dc1a696d72e05e7a5c895bdee51bd4d"}]
# The JSON above stores only lowercase SHA-256 digests. Each digest must match
# the corresponding raw PLATFORM_RELAY_OPERATIONS_TOKEN; never place the raw
# token in NEW_API_RELAY_OPERATIONS_CREDENTIALS_JSON.
# Independent tenant-bound HMAC keys for approving unknown-submit decisions.
# Each secret must differ from the operations token and all other service keys.
NEW_API_RELAY_RECONCILIATION_APPROVAL_KEYS_JSON=[{"tenant_id":"00000000-0000-4000-8000-000000000001","key_id":"local-platform-approval-v1","secret":"local-platform-reconciliation-approval-secret-change-me-04"}]
# Leave both blank for the initial control-plane boot. Configure exactly one
# after channels are provisioned. Production requires secret-free route
# declarations so the public capability is a failover-safe intersection;
# direct capabilities are for a development contract harness only.
NEW_API_RELAY_MODEL_ROUTES_JSON=
NEW_API_RELAY_MODEL_CAPABILITIES_JSON=
# The ordinary Compose data plane starts its durable workers. With no route
# declarations it remains honestly degraded until channels are configured;
# protected deployments require the complete attested route inventory.
NEW_API_RELAY_WORKER_ENABLED=true
NEW_API_RELAY_INTERNAL_ADMISSION_TOKEN=replace-with-a-different-long-random-internal-token
NEW_API_RELAY_SUBMISSION_TIMEOUT_SECONDS=120
# Redis is a derived durable scheduler; PostgreSQL remains the outbox truth.
# Production startup verifies Redis AOF and fails closed if it is unavailable.
NEW_API_RELAY_DELAY_QUEUE_NAMESPACE=new-api-relay
NEW_API_RELAY_DELAY_QUEUE_LEASE_SECONDS=30
NEW_API_RELAY_DELAY_QUEUE_RECOVERY_SECONDS=1
NEW_API_RELAY_DELAY_QUEUE_RECOVERY_BATCH=256
NEW_API_RELAY_ARTIFACT_STORE=filesystem
NEW_API_RELAY_ARTIFACT_SIGNING_SECRET=replace-with-a-long-random-new-api-artifact-signing-key
NEW_API_RELAY_ARTIFACT_MAX_BYTES=536870912
NEW_API_RELAY_ARTIFACT_TIMEOUT_SECONDS=60
# Must exceed the Gateway ticket TTL plus its source-expiry safety margin.
NEW_API_RELAY_ARTIFACT_SIGNED_URL_TTL_SECONDS=600
# Keep monitoring disabled only during the empty development bootstrap.
# Staging/production require it plus both signed delivery destinations.
NEW_API_RELAY_PROVIDER_MONITOR_ENABLED=false
NEW_API_RELAY_PROVIDER_MONITOR_INTERVAL_SECONDS=30
NEW_API_RELAY_PROVIDER_MONITOR_LEASE_SECONDS=120
NEW_API_RELAY_PROVIDER_CHANNEL_TEST_MAX_AGE_SECONDS=300
# Local development keeps native provider probes off. The secure staging and
# production overlays require true plus a positive frequency shorter than the
# maximum age (including the scheduler delay).
NEW_API_RELAY_CHANNEL_TEST_ENABLED=false
NEW_API_RELAY_CHANNEL_TEST_FREQUENCY=10
NEW_API_RELAY_PROVIDER_MONITOR_ACQUIRE_RETRY_SECONDS=5
NEW_API_RELAY_PROVIDER_HEALTHCHECK_TIMEOUT_SECONDS=5
NEW_API_RELAY_PROVIDER_MONITOR_WINDOW_SECONDS=300
NEW_API_RELAY_PROVIDER_MONITOR_MIN_OUTCOMES=20
NEW_API_RELAY_PROVIDER_MONITOR_MIN_SUCCESS_RATE=0.80
NEW_API_RELAY_PROVIDER_MONITOR_SUCCESS_RECOVERY_RATE=0.95
NEW_API_RELAY_PROVIDER_MONITOR_WIDESPREAD_FAILURE_RATIO=0.50
NEW_API_RELAY_PROVIDER_MONITOR_WIDESPREAD_RECOVERY_RATIO=0.20
NEW_API_RELAY_PROVIDER_MONITOR_WIDESPREAD_MIN_ROUTES=2
NEW_API_RELAY_PROVIDER_MONITOR_BATCH_DISABLED_THRESHOLD=3
# Provider alert delivery is optional for the empty development bootstrap. When
# enabling it, point this URL to the Platform's exact signed receiver endpoint
# and use the same inbound secret that the Platform receives through Compose.
# Production must use its public HTTPS Platform address; local Compose may use:
# http://platform-api:8000/internal/relay/provider-alerts
NEW_API_RELAY_PROVIDER_ALERT_WEBHOOK_URL=
NEW_API_RELAY_PROVIDER_ALERT_SIGNING_SECRET=
NEW_API_RELAY_PROVIDER_ALERT_CLAIM_LEASE_SECONDS=60
NEW_API_RELAY_PROVIDER_ALERT_POLL_SECONDS=0.5
NEW_API_RELAY_PLATFORM_CHANNEL_COST_URL=
# Immutable provider contract prices used by the normal runtime cost worker.
# Use a JSON array of versioned, evidence-backed rates; missing rates remain an
# explicit incomplete reconciliation and are never treated as zero cost.
NEW_API_RELAY_PROVIDER_CONTRACT_RATES_JSON=
NEW_API_RELAY_CHANNEL_COST_CLAIM_LEASE_SECONDS=60
NEW_API_RELAY_CHANNEL_COST_POLL_SECONDS=0.5
# Signed production telemetry consumed by the Platform operations dashboards.
# Production must point both endpoints at the customer Platform and configure
# the same RELAY_TELEMETRY_SIGNING_SECRET on both services.
NEW_API_RELAY_PLATFORM_TASK_STAGE_URL=
NEW_API_RELAY_PLATFORM_OPERATIONS_SNAPSHOT_URL=
NEW_API_RELAY_TELEMETRY_CLAIM_LEASE_SECONDS=60
NEW_API_RELAY_TELEMETRY_POLL_SECONDS=0.5
# Deprecated Compose aliases. Leave empty when the canonical values above are
# present; if used for an older deployment, both services consume the same alias.
NEW_API_RELAY_PLATFORM_INTERNAL_SERVICE_TOKEN=
NEW_API_RELAY_PLATFORM_CHANNEL_COST_SIGNING_SECRET=

# Controlled full-body artifact download Gateway. It is a separate binary in
# the new-api Relay image. Its container does not inherit Redis, Relay tenant or
# channel credentials, OBS AK/SK, callback, alert, monitor, or cost secrets.
NEW_API_RELAY_DOWNLOAD_EDGE_HOST_PORT=8400
NEW_API_RELAY_DOWNLOAD_EDGE_ENVIRONMENT=development
# Production must set this to a dedicated PostgreSQL DML-only role. The Gateway
# maps it to SQL_DSN inside the process with migrations disabled; do not reuse
# the new-api owner/migration credential.
RELAY_DOWNLOAD_EDGE_SQL_DSN=
RELAY_DOWNLOAD_EDGE_POSTGRES_PASSWORD=replace-with-a-long-random-edge-only-postgres-password
# Exact host[:port] values from OBS signed URLs; no wildcard/suffix matching.
# A virtual-hosted bucket URL normally needs `<bucket>.obs.<region>.myhuaweicloud.com`.
NEW_API_RELAY_DOWNLOAD_EDGE_ALLOWED_OBS_HOSTS=
# Each value below is independent. Base64 values decode to exactly 32 random
# bytes; the Ed25519 value is a 32-byte seed or 64-byte private key. Production
# rejects the deterministic local Compose defaults as well as placeholders.
NEW_API_RELAY_DOWNLOAD_EDGE_TICKET_TOKEN_KEY_BASE64=
NEW_API_RELAY_DOWNLOAD_EDGE_SOURCE_ENCRYPTION_KEY_BASE64=
NEW_API_RELAY_DOWNLOAD_EDGE_PROOF_PRIVATE_KEY_BASE64=
NEW_API_RELAY_DOWNLOAD_EDGE_PROOF_KEY_ID=
NEW_API_RELAY_DOWNLOAD_EDGE_PROOF_READ_TOKEN=
NEW_API_RELAY_DOWNLOAD_EDGE_PRODUCER_SUBJECT=relay-download-edge/local
NEW_API_RELAY_DOWNLOAD_EDGE_PLATFORM_COMPLETION_URL=http://platform-api:8000/internal/artifact-download-completions/edge-gateway
NEW_API_RELAY_DOWNLOAD_EDGE_TICKET_TTL_SECONDS=300
NEW_API_RELAY_DOWNLOAD_EDGE_SOURCE_EXPIRY_MARGIN_SECONDS=60
NEW_API_RELAY_DOWNLOAD_EDGE_REGISTRATION_MAX_AGE_SECONDS=300
NEW_API_RELAY_DOWNLOAD_EDGE_TRANSFER_TIMEOUT_SECONDS=300
# The ticket claim covers transfer timeout plus this final database-commit margin.
NEW_API_RELAY_DOWNLOAD_EDGE_TRANSFER_COMPLETION_MARGIN_SECONDS=10
NEW_API_RELAY_DOWNLOAD_EDGE_TICKET_CLAIM_LEASE_SECONDS=330
# The delivery claim covers the fixed 15s Platform HTTP timeout plus this
# final proof/outbox database-commit margin.
NEW_API_RELAY_DOWNLOAD_EDGE_DELIVERY_CLAIM_LEASE_SECONDS=60
NEW_API_RELAY_DOWNLOAD_EDGE_DELIVERY_COMMIT_MARGIN_SECONDS=10
NEW_API_RELAY_DOWNLOAD_EDGE_DELIVERY_POLL_SECONDS=1
NEW_API_RELAY_DOWNLOAD_EDGE_DELIVERY_MAX_ATTEMPTS=8
NEW_API_RELAY_DOWNLOAD_EDGE_MAX_ARTIFACT_BYTES=5368709120

# Frontend production identity is runtime-only. Do not add a token, user ID, or
# company identity to VITE_* or any static build environment. The deploy layer
# may inject window.__AI_VIDEO_RUNTIME_CONFIG__ with platformApiUrl/companyId.
# platformApiUrl is deploy-controlled only; when absent the UI uses same-origin;
# the external IdP or single-user login writes only the short-lived token to
# sessionStorage["ai-video.access-token"].

# Optional local new-api OBS settings. Protected environments use the
# process-scoped API secret bundle and never inject production AK/SK here.
HUAWEI_OBS_ENDPOINT=https://obs.example.com
HUAWEI_OBS_BUCKET=replace-with-private-bucket
HUAWEI_OBS_ACCESS_KEY_ID=replace-with-iam-access-key
HUAWEI_OBS_SECRET_ACCESS_KEY=replace-with-iam-secret-key
# Required only when IAM supplies temporary credentials. Keep it absent for a
# long-lived AK/SK; never write a real token into this repository.
# HUAWEI_OBS_SECURITY_TOKEN=replace-with-temporary-security-token

# Production input assets use the same private OBS boundary and HTTPS short
# signatures. Filesystem storage is intentionally limited to local/test mode.
# INPUT_ASSET_STORE=huawei_obs
# INPUT_ASSET_PUBLIC_BASE_URL=https://api.example.com
# INPUT_ASSET_RELAY_BASE_URL=https://api.example.com
# INPUT_ASSET_SIGNED_URL_SECONDS=300
# INPUT_ASSET_RELAY_SIGNED_URL_SECONDS=3600

# Production customer-platform JWT verification. Inject these from a secret
# manager; this repository does not yet provide the real IdP login flow.
# JWT_SIGNING_SECRET=replace-with-at-least-32-random-utf8-bytes
# JWT_ISSUER=ai-video-production-idp
# JWT_AUDIENCE=ai-video-web
# Highest-privilege platform owner subjects from the real IdP. JSON list.
# Production refuses to start when this allowlist is empty.
# PLATFORM_OWNER_USER_IDS=["00000000-0000-0000-0000-000000000000"]
# Accepted phishing-resistant `amr` values in administrator JWTs.
# PLATFORM_ADMIN_REQUIRED_AMR=["webauthn","passkey","fido","hwk"]
# Non-read administrator requests require auth_time within this many seconds.
# PLATFORM_ADMIN_STEP_UP_MAX_AGE_SECONDS=300
