ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://platform:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/ai_video_platform
AUTO_CREATE_TABLES=false
DEVELOPMENT_HEADER_AUTH_ENABLED=false
ENABLE_BOOTSTRAP=false
# BOOTSTRAP_TOKEN is intentionally unset in production.
CORS_ORIGINS=["https://app.example.com"]
AUTH_LEGACY_BEARER_ENABLED=false
OIDC_ENABLED=true
OIDC_SELF_SIGNUP_ENABLED=false
OIDC_ISSUER=https://idp.example.com/
OIDC_AUTHORIZATION_ENDPOINT=https://idp.example.com/oauth2/authorize
OIDC_TOKEN_ENDPOINT=https://idp.example.com/oauth2/token
OIDC_JWKS_URI=https://idp.example.com/.well-known/jwks.json
OIDC_CLIENT_ID=ai-video-platform
OIDC_REDIRECT_URI=https://platform.example.com/api/v1/auth/callback
FRONTEND_ORIGIN=https://app.example.com
ACCOUNT_MANAGEMENT_URL=https://idp.example.com/account
AUTH_SESSION_TTL_SECONDS=28800
AUTH_SESSION_IDLE_TTL_SECONDS=1800
AUTH_ACCOUNT_STEP_UP_MAX_AGE_SECONDS=300
OIDC_LOGIN_TRANSACTION_TTL_SECONDS=600
OIDC_ID_TOKEN_MAX_LIFETIME_SECONDS=900
OIDC_LOGIN_IP_WINDOW_SECONDS=600
OIDC_LOGIN_IP_MAX_ATTEMPTS=20
INVITATION_TTL_SECONDS=604800
PLATFORM_OWNER_USER_IDS=["replace-with-idp-owner-subject"]
PLATFORM_ADMIN_REQUIRED_AMR=["webauthn"]
# Protected staging/production receives this sole native new-api backend from
# each role-specific runtime secret bundle. Direct JSON is local-development
# configuration only; scalar RELAY_BASE_URL/CLIENT_ID/API_KEY are retired.
RELAY_DEFAULT_BACKEND_ID=new-api-v1
RELAY_DEFAULT_CONTRACT_REVISION=generations.v1
# RELAY_BACKENDS={"new-api-v1":{"base_url":"https://relay-new-api.example.com","client_id":"platform-new-api","api_key":"REPLACE_WITH_RANDOM_KEY_AT_LEAST_32_BYTES","contract_revision":"generations.v1"}}
# The backend-qualified callback is the only callable callback route after
# cutover. Its secret must be distinct from every API and service credential.
RELAY_CALLBACK_PUBLIC_URL=https://platform.example.com/internal/relay-callbacks
# RELAY_CALLBACK_SIGNING_SECRETS={"new-api-v1":"REPLACE_WITH_RANDOM_NEW_API_CALLBACK_KEY_AT_LEAST_32_BYTES"}
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_TOKEN_AT_LEAST_32_BYTES
# These four HMAC keys must be independent from the internal service token,
# from each other, and from callback/JWT/API credentials.
CHANNEL_COST_SIGNING_SECRET=REPLACE_WITH_RANDOM_CHANNEL_COST_KEY_AT_LEAST_32_BYTES
RELAY_TELEMETRY_SIGNING_SECRET=REPLACE_WITH_RANDOM_RELAY_TELEMETRY_KEY_AT_LEAST_32_BYTES
DOWNLOAD_COMPLETION_EDGE_GATEWAY_SIGNING_SECRET=REPLACE_WITH_RANDOM_EDGE_DOWNLOAD_KEY_AT_LEAST_32_BYTES
DOWNLOAD_COMPLETION_OBS_ACCESS_LOG_SIGNING_SECRET=REPLACE_WITH_RANDOM_OBS_DOWNLOAD_KEY_AT_LEAST_32_BYTES
# Production always fails closed if channel-cost signing is disabled.
CHANNEL_COST_SIGNATURE_REQUIRED=true
CHANNEL_COST_SIGNATURE_MAX_AGE_SECONDS=300
RELAY_TELEMETRY_SIGNATURE_MAX_AGE_SECONDS=300
DOWNLOAD_COMPLETION_SIGNATURE_MAX_AGE_SECONDS=300
